+/* V4L2 timestamps use CLOCK_MONOTONIC, while legacy uStreamer timings
+ * use CLOCK_MONOTONIC_RAW. Keep the legacy timing contract unchanged. */
+static inline uint64_t frame_capture_now_ns(void) {
+	struct timespec ts;
+	if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
+	return (uint64_t)ts.tv_sec * 1000000000ULL + (uint64_t)ts.tv_nsec;
+}
+
 static inline void frame_copy_meta(const frame_s *src, frame_s *dest) {
 	FRAME_COPY_META(src, dest);
+	dest->capture_timestamp_ns = src->capture_timestamp_ns;
+	dest->capture_epoch_ns = src->capture_epoch_ns;
+	dest->capture_sequence = src->capture_sequence;
+	dest->capture_flags = src->capture_flags;
 }
 
