#!/bin/sh
# Non-blocking SysV boot entry; the supervisor handles network readiness and retries.
APP_DIR=${FUSION_APP_DIR:-/opt/fusion-sensor}
RUN_DIR=${FUSION_RUN_DIR:-/var/run}
SUPERVISOR="$APP_DIR/fusion-supervisor.sh"
PIDFILE="$RUN_DIR/fusion-sensor.pid"
LOGFILE=${FUSION_LOGFILE:-/var/log/fusion-sensor.log}

is_running() {
    [ -r "$PIDFILE" ] || return 1
    pid=$(cat "$PIDFILE" 2>/dev/null)
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    [ "$pid" -gt 1 ] && kill -0 "$pid" 2>/dev/null || return 1
    # A stale PID file must never signal an unrelated process.
    tr '\000' '\n' <"/proc/$pid/cmdline" 2>/dev/null | grep -Fxq "$SUPERVISOR"
}
start() {
    if is_running; then echo "fusion-sensor already supervised (pid $pid)"; return 0; fi
    [ -x "$SUPERVISOR" ] && [ -x "$APP_DIR/start_fusion.sh" ] || {
        echo 'missing capture launcher or supervisor'; return 1;
    }
    mkdir -p "$RUN_DIR"
    setsid bash "$SUPERVISOR" >>"$LOGFILE" 2>&1 </dev/null &
    sleep 1
    if is_running; then
        echo "fusion-sensor supervisor started (pid $pid); readiness is asynchronous"
    else
        echo "fusion-sensor supervisor failed; see $LOGFILE"
        return 1
    fi
}
stop() {
    if is_running; then
        kill -TERM "$pid" 2>/dev/null || true
        count=0
        while is_running && [ "$count" -lt 12 ]; do sleep 1; count=$((count + 1)); done
        if is_running; then
            echo 'supervisor stop timed out; leaving PID/lock for inspection'
            return 1
        fi
    fi
    echo 'fusion-sensor stopped'
}
status() {
    if is_running; then
        current=$(cat "$RUN_DIR/fusion-sensor.state" 2>/dev/null || echo starting)
        echo "fusion-sensor supervised (pid $pid), state=$current"
        [ "$current" = healthy ]
    else
        echo 'fusion-sensor stopped'
        return 1
    fi
}
case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop && start ;;
    status) status ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
